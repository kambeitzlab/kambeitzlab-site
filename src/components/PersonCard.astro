---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props { person: CollectionEntry<'team'>; eager?: boolean }
const { person, eager = false } = Astro.props;
const { name, title, position, photo, show_photo, photo_focus, group } = person.data;
const initials = name.split(/\s+/).map((p) => p[0]).slice(0, 2).join('');
---

<article class="person">
  <div class="photo">
    {show_photo && photo ? (
      <Picture formats={['avif', 'webp']}
        src={photo}
        alt=""
        widths={[240, 400, 600]}
        sizes="(max-width: 540px) 45vw, (max-width: 900px) 30vw, 220px"
        style={`object-position:${photo_focus}`}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="initials" aria-hidden="true">{initials}</span>
    )}
  </div>
  <h3 class="name"><a href={url(`/team/${person.id}/`)}>{name}</a></h3>
  <p class="meta">{title && <span>{title} · </span>}{position}</p>
  {group && <p class="group">Head of {group.name}</p>}
</article>

<style>
  .person { position: relative; }
  .photo {
    aspect-ratio: 1; border-radius: var(--radius); overflow: hidden;
    background: var(--surface-2); margin-bottom: 0.75rem;
  }
  .photo :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.02);
    transition: filter 0.35s ease, transform 0.35s ease;
  }
  .person:hover .photo :global(img),
  .person:focus-within .photo :global(img) { filter: none; }
  @media (prefers-reduced-motion: no-preference) {
    .person:hover .photo :global(img) { transform: scale(1.03); }
  }
  .initials {
    display: grid; place-items: center; width: 100%; height: 100%;
    font: 600 2.2rem/1 var(--font-head); color: var(--accent);
  }
  .name { font-size: 1.05rem; margin: 0 0 0.15rem; }
  .name a { color: var(--text); text-decoration: none; }
  .name a::after { content: ''; position: absolute; inset: 0; }
  .person:hover .name a, .name a:focus-visible { color: var(--accent); text-decoration: underline; }
  .meta { font-size: 0.88rem; color: var(--muted); margin: 0; }
  .group {
    margin: 0.4rem 0 0; font-size: 0.82rem; font-weight: 600; line-height: 1.35; color: var(--accent-strong);
    padding-left: 0.6rem; border-left: 2px solid var(--accent);
  }
</style>
