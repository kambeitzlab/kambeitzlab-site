---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib/url';

interface Props { post: CollectionEntry<'news'>; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel: H = 'h3' } = Astro.props;
const { title, date, type, image, image_alt, excerpt, lang } = post.data;
---

<article class="news-item">
  <div class="thumb">
    {image ? (
      <Picture formats={['avif', 'webp']} src={image} alt={image_alt} widths={[160, 320]} sizes="(max-width: 600px) 96px, 128px" />
    ) : (
      <span class="ph" aria-hidden="true" />
    )}
  </div>
  <div class="body">
    <p class="meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      <span class="tag">{type}</span>
    </p>
    <H class="title" lang={lang}><a href={url(`/news/${post.id}/`)}>{title}</a></H>
    {excerpt && <p class="excerpt" lang={lang}>{excerpt}</p>}
  </div>
</article>

<style>
  .news-item {
    position: relative; display: grid; grid-template-columns: 128px 1fr; gap: 1rem;
    padding-block: 1rem; border-bottom: 1px solid var(--border);
  }
  .news-item:first-child { padding-top: 0; }
  .thumb :global(img), .ph {
    width: 128px; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 8px; background: var(--surface-2); display: block;
  }
  .meta { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.3rem; font-size: 0.85rem; color: var(--muted); }
  .title { font-size: 1.08rem; margin: 0 0 0.25rem; line-height: 1.3; }
  .title a { color: var(--text); text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .news-item:hover .title a { color: var(--accent); text-decoration: underline; }
  .excerpt {
    margin: 0; font-size: 0.93rem; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (max-width: 600px) {
    .news-item { grid-template-columns: 96px 1fr; }
    .thumb :global(img), .ph { width: 96px; }
  }
</style>
