---
// Decorative abstract network, generated at build time (deterministic seed),
// so it costs no JavaScript. Purely presentational: aria-hidden.
const W = 640;
const H = 520;
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

// Jittered grid -> evenly spread but organic.
const nodes: { x: number; y: number; r: number; hub: boolean }[] = [];
const cols = 7;
const rows = 6;
for (let i = 0; i < cols; i++) {
  for (let j = 0; j < rows; j++) {
    if (rand() < 0.18) continue;
    nodes.push({
      x: 40 + (i + 0.5) * ((W - 80) / cols) + (rand() - 0.5) * 60,
      y: 30 + (j + 0.5) * ((H - 60) / rows) + (rand() - 0.5) * 50,
      r: 2.5 + rand() * 3,
      hub: false,
    });
  }
}
// A few larger "hub" nodes.
[...nodes].sort(() => rand() - 0.5).slice(0, 5).forEach((n) => { n.hub = true; n.r = 7 + rand() * 3; });

const edges: [number, number][] = [];
nodes.forEach((a, i) => {
  const near = nodes
    .map((b, j) => ({ j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
    .filter(({ j, d }) => j > i && d < 135)
    .sort((p, q) => p.d - q.d)
    .slice(0, a.hub ? 5 : 2);
  near.forEach(({ j }) => edges.push([i, j]));
});
const pulses = edges.filter((_, k) => k % 7 === 3).slice(0, 6);
---

<svg class="network" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  <g class="edges">
    {edges.map(([i, j]) => <line x1={nodes[i].x} y1={nodes[i].y} x2={nodes[j].x} y2={nodes[j].y} />)}
  </g>
  <g class="pulses">
    {
      pulses.map(([i, j], k) => (
        <line
          x1={nodes[i].x} y1={nodes[i].y} x2={nodes[j].x} y2={nodes[j].y}
          pathLength="100" style={`animation-delay:${k * 1.3}s`}
        />
      ))
    }
  </g>
  <g class="nodes">
    {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} class={n.hub ? 'hub' : ''} />)}
  </g>
</svg>

<style>
  .network { width: 100%; height: auto; overflow: visible; }
  .edges line { stroke: var(--graph); stroke-opacity: 0.22; stroke-width: 1.2; }
  .nodes circle { fill: var(--graph); fill-opacity: 0.45; }
  .nodes circle.hub { fill-opacity: 1; stroke: var(--bg); stroke-width: 3; }
  .pulses line { stroke: var(--graph); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 0 100; opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .pulses line { animation: pulse 8s ease-in-out infinite; }
    @keyframes pulse {
      0% { stroke-dasharray: 0 100; stroke-dashoffset: 0; opacity: 0; }
      8% { opacity: 0.9; }
      30% { stroke-dasharray: 100 0; stroke-dashoffset: 0; opacity: 0.9; }
      45%, 100% { stroke-dasharray: 100 0; opacity: 0; }
    }
  }
</style>
