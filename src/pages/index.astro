---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NetworkGraph from '../components/NetworkGraph.astro';
import PatientNotice from '../components/PatientNotice.astro';
import ThemeIcon from '../components/ThemeIcon.astro';
import NewsItem from '../components/NewsItem.astro';
import PubItem from '../components/PubItem.astro';
import { partners, site } from '../data/site';
import { themes } from '../data/themes';
import { getPublications } from '../lib/publications';
import { url } from '../lib/url';

const projects = await getCollection('projects');
const projectCount = (id: string) => projects.filter((p) => p.data.theme === id).length;

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const selected = (await getPublications()).filter((p) => p.selected).slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.name} · University Hospital Cologne</p>
        <h1>{site.tagline}</h1>
        <p class="mission">{site.mission}</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('/research/')}>Our research</a>
          <a class="btn btn-ghost" href={url('/join/')}>Join us</a>
        </div>
      </div>
      <div class="hero-art">
        <NetworkGraph />
      </div>
    </div>
  </section>

  <PatientNotice />

  <section class="section" aria-labelledby="themes-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="themes-title">Research themes</h2>
        <a class="more-link" href={url('/research/')}>All research</a>
      </div>
      <ul class="tiles grid-12" role="list">
        {
          themes.map((t) => (
            <li class="tile card">
              <ThemeIcon id={t.id} />
              <h3><a href={url(`/research/${t.id}/`)}>{t.title}</a></h3>
              <p>{t.description}</p>
              <p class="count">
                {projectCount(t.id)} {projectCount(t.id) === 1 ? 'project' : 'projects'}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-12 two-col">
      <div class="col" aria-labelledby="news-title">
        <div class="section-head">
          <h2 id="news-title">Latest news</h2>
          <a class="more-link" href={url('/news/')}>All news</a>
        </div>
        {news.map((post) => <NewsItem post={post} />)}
      </div>
      <div class="col" aria-labelledby="pubs-title">
        <div class="section-head">
          <h2 id="pubs-title">Selected publications</h2>
          <a class="more-link" href={url('/publications/')}>All publications</a>
        </div>
        {selected.map((pub) => <PubItem pub={pub} maxAuthors={6} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="join card">
        <div>
          <h2>Join us</h2>
          <p>
            We welcome PhD, MD and MSc students and visiting researchers who want to work at the meeting point of clinic and computation.
          </p>
        </div>
        <a class="btn btn-primary" href={url('/join/')}>Positions &amp; theses</a>
      </div>
    </div>
  </section>

  {
    partners.length > 0 && (
      <section class="section partners" aria-labelledby="partners-title">
        <div class="wrap">
          <h2 id="partners-title" class="eyebrow">Partners &amp; funders</h2>
          <ul class="logo-strip" role="list">
            {partners.map((p) => (
              <li>
                <img src={url(p.logo)} alt={p.name} loading="lazy" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .hero h1 { margin-bottom: 0.5em; max-width: 20ch; font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); }
  .mission {
    font-size: clamp(1.08rem, 1rem + 0.4vw, 1.25rem); line-height: 1.6;
    color: var(--muted); max-width: 52ch; margin-bottom: 2rem;
  }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-art { max-width: 560px; justify-self: end; width: 100%; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { order: -1; max-width: 420px; justify-self: center; margin-bottom: -1rem; opacity: 0.9; }
  }

  .tiles { list-style: none; margin: 0; padding: 0; }
  .tile { grid-column: span 3; padding: 1.5rem; position: relative; display: flex; flex-direction: column; }
  .tile h3 { margin: 1rem 0 0.5rem; font-size: 1.15rem; }
  .tile h3 a { color: var(--text); text-decoration: none; }
  .tile h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .tile:hover h3 a { color: var(--accent); }
  .tile:hover { border-color: var(--accent); }
  .tile:focus-within { outline: 3px solid var(--accent); outline-offset: 3px; }
  .tile h3 a:focus-visible { outline: none; }
  .tile p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
  .tile .count { margin: auto 0 0; font-size: 0.82rem; font-weight: 600; color: var(--accent); }
  @media (max-width: 1000px) { .tile { grid-column: span 6; } }
  @media (max-width: 560px) { .tile { grid-column: span 12; } }

  .two-col .col { grid-column: span 6; }
  @media (max-width: 860px) { .two-col .col { grid-column: span 12; } .two-col .col + .col { margin-top: 2.5rem; } }

  .join {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--accent-soft); border-color: transparent; box-shadow: none;
  }
  .join h2 { margin-bottom: 0.3rem; }
  .join p { margin: 0; max-width: 60ch; }

  .logo-strip {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem;
  }
  .logo-strip li { display: grid; place-items: center; min-height: 64px; }
  .logo-strip img { max-height: 48px; width: auto; filter: grayscale(1); opacity: 0.75; }
  :global(:root[data-theme='dark']) .logo-strip img { filter: grayscale(1) invert(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo-strip img { filter: grayscale(1) invert(1); }
  }
</style>
