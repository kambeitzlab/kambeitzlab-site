---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <div class="wrap section">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead">This page does not exist (any more). Many pages moved when we rebuilt the website.</p>
    <p><a class="btn btn-primary" href={url('/')}>Go to the home page</a></p>
  </div>
</Base>
