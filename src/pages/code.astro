---
import Base from '../layouts/Base.astro';
import { repos } from '../data/code';
import { site } from '../data/site';
---

<Base title="Code & tools" description="Open-source code and tools from the Kambeitz Lab.">
  <div class="wrap section">
    <header class="page-head">
      <p class="eyebrow">Code &amp; tools</p>
      <h1>Code &amp; tools</h1>
      <p class="lead">Open-source software from our projects. We share analysis code with our papers wherever data protection allows.</p>
    </header>

    {
      repos.length === 0 ? (
        <p class="empty">Our public repositories will be listed here soon.</p>
      ) : (
        <ul class="repos" role="list">
          {repos.map((r) => (
            <li class="card">
              <h2><a href={r.url} rel="noopener">{r.name}</a></h2>
              <p>{r.description}</p>
              <p class="meta">
                {r.language && <span class="tag">{r.language}</span>}
                {r.paper && <a href={r.paper} rel="noopener">Paper</a>}
              </p>
            </li>
          ))}
        </ul>
      )
    }
    {site.github && <p><a class="more-link" href={site.github} rel="noopener">All repositories on GitHub</a></p>}
  </div>
</Base>

<style>
  .page-head { margin-bottom: 2.5rem; }
  .empty { color: var(--muted); }
  .repos { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); }
  .repos .card { padding: 1.25rem; }
  .repos h2 { font: 600 1.1rem/1.3 var(--font-body); margin-bottom: 0.4rem; }
  .repos p { color: var(--muted); font-size: 0.95rem; }
  .meta { display: flex; gap: 0.75rem; align-items: center; margin: 0; }
</style>
